export VIRTUAL_ENV_DISABLE_PROMPT=1

# 1. ROS 2 base environment
source /opt/ros/humble/setup.bash

# 2. Workspace build result (skipped before the first build)
# Watched so direnv reloads after colcon build. Adding a new package leaves setup.bash unchanged,
# so log/latest_build, which points to a new folder on every build, is watched too.
watch_file install/setup.bash
watch_file log/latest_build
if [ -f "install/setup.bash" ]; then
    source install/setup.bash
fi

# 3. Python virtual environment (created if missing; system-site-packages for rclpy)
if [ ! -d ".venv" ]; then
    python3 -m venv --system-site-packages .venv
fi
source .venv/bin/activate

# 4. Run colcon with the .venv Python. Then the first line (shebang) of the scripts that ros2 run
#    executes is the .venv Python, so packages installed only in .venv (arena_api) are found.
#    (The system colcon runs with /usr/bin/python3, so the shebang would be the system Python.)
if [ ! -x ".venv/bin/colcon" ]; then
    printf '#!/bin/sh\nexec "%s/.venv/bin/python3" -m colcon "$@"\n' "$PWD" > .venv/bin/colcon
    chmod +x .venv/bin/colcon
fi
